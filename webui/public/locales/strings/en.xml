    <string name="help_save_and_update_description">Save current configure.</string>
    <string name="help_select_denylist">Select From DenyList</string>
    <string name="help_select_denylist_description">Available in Magisk only, select apps that are in the DenyList. Recommended.</string>
    <string name="help_deselect_unnecessary">Deselect Unnecessary</string>
    <string name="help_deselect_unnecessary_description">**Unnecessary category** - Xposed module, root manager, root-related apps, and general apps that never check bootloader status. This option requires Internet connection.</string>
    <string name="help_add_system_app">Add System App</string>
    <string name="help_add_system_app_description">Add specific system app to app list.</string>
    <string name="help_set_keybox">Set Keybox</string>
    <string name="help_set_keybox_description">Replace TrickyStore keybox with:</string>
    <string name="help_set_keybox_aosp">**AOSP** - the default keybox comes with TrickyStore.</string>
    <string name="help_set_keybox_unknown">**Unknown** - self-signed and not valid for Play Integrity verdict.</string>
    <string name="help_set_keybox_local">**Local** - select keybox from your device.</string>
    <string name="help_set_keybox_custom">**Custom** - custom keybox provider via online fetching.</string>
    <string name="help_set_default_policy">Set Default Policy</string>
    <string name="help_set_default_policy_description">Formerly `Set Security Patch`. Config default policy for all targeted apps, Leave blank or `no` to disable, `prop` to keep consist with system prop.</string>
    <string name="help_prop_settings">Prop Settings</string>
    <string name="help_prop_settings_description">Various prop related settings:</string>
    <string name="help_prop_settings_handler">**Prop handler** - shamiko resetprop script toggle.</string>
    <string name="help_prop_settings_boot_hash">**Boot hash** - get `verifiedBootHash` value from [KeyAttestation](https://github.com/vvb2060/KeyAttestation/releases). Fix abnormal boot state by resetting `ro.boot.vbmeta.digest`.</string>
    <string name="help_prop_settings_hide_props">**Property hiding** - hide or override system props via `resetprop`. One prop per line; a bare name deletes it (e.g. `ro.debuggable`), `prop=value` sets a value. Re-applied on boot.</string>
    <string name="help_prop_settings_usb_debug">**USB debugging** - toggle `adb_enabled`. Disabling it does not affect the WebUI session.</string>
